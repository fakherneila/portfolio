VITE_SITE_URL=https://your-domain.example
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Admin blog editor (GitHub Contents API)
# The owner/repo where content/blog/ lives — e.g. "fakher-neila/portfolio"
VITE_ADMIN_GITHUB_REPO=
# The branch to commit to — usually "main"
VITE_ADMIN_GITHUB_BRANCH=main
# Optional: prefill the login form with this username hint (display only)
VITE_ADMIN_GITHUB_USERNAME=

